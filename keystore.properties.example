# 配布用 APK に署名するための設定のテンプレート。
#
# 使い方:
#   1. このファイルを keystore.properties という名前でコピーする
#   2. 自分の署名鍵の情報に書き換える
#
# keystore.properties と鍵ファイル(.jks)は .gitignore 済みで、リポジトリには含まれません。
# 鍵を失うと同じ署名でのアップデートが出せなくなるため、必ずバックアップしてください。

# 鍵ファイルの場所（プロジェクトのルートからの相対パス）
storeFile=release.jks

# キーストアのパスワード
storePassword=

# 鍵のエイリアス（作成時に指定した名前）
keyAlias=

# 鍵のパスワード
keyPassword=
