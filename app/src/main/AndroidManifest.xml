<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ で通知を出すために必須 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      正確なアラームの権限。目覚まし時計と同じ扱いで時刻を予約するために要る。

      Android 13+ を対象にすると SCHEDULE_EXACT_ALARM はインストール時に許可されず、
      ユーザーが設定画面で手動で有効にするまで拒否される。つまり入れた直後の既定状態が
      「正確な時刻には鳴らない」になってしまう。時刻ちょうどに鳴ることが存在理由のアプリで、
      それを利用者の手作業に賭けるわけにはいかない。

      目覚まし時計・カレンダーのためにある USE_EXACT_ALARM はインストール時に自動で
      許可され、ユーザーの操作を一切必要としない。まさにこの用途のための権限なので、
      こちらを主に使う。SCHEDULE_EXACT_ALARM は USE_EXACT_ALARM が存在しない
      Android 12 以前のためだけに残す。
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- ロック画面上でも緊急通知を全画面表示するため -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 再起動後にアラームを再スケジュールするため -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- バッテリー最適化の対象外設定へ誘導するため -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- DND(おやすみモード)ポリシーへのアクセスを宣言 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- 通知が溜まっている/ロック解除中でも全画面アラームを最前面に出すため（他のアプリの上に表示） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      allowBackup=false: Android の自動バックアップを使わない。
      有効にすると、アプリは通信していないのに OS が提出物のデータベースを Google の
      サーバーへ上げてしまい、「データは端末の中だけにある」と言えなくなる。
      引き換えに機種変更でデータは引き継げないが、そこは割り切る。
      アンインストールで確実に消えるので、消したつもりのデータが復活することもない。
    -->
    <application
        android:name=".SubmissionUltraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubmissionUltra">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SubmissionUltra"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 緊急通知が鳴ったときに全画面で出るアラーム画面。ロック画面上でも表示する。
             画面回転などで作り直されると鳴動が途切れるため、構成変更は自前で受け止める。 -->
        <activity
            android:name=".ui.alarm.EmergencyAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.SubmissionUltra" />

        <!-- 緊急通知の発火本体を受け取る。AlarmManager からのみ呼ばれるため exported=false -->
        <receiver
            android:name=".notification.AlarmReceiver"
            android:exported="false" />

        <!-- 緊急通知の「完了にする」アクションを受け取る。 -->
        <receiver
            android:name=".notification.EmergencyActionReceiver"
            android:exported="false" />

        <!-- 締切3日前からのリマインダーを受け取る。AlarmManager からのみ呼ばれる -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false" />

        <!-- 設定済みのアラームが OS 側で消える出来事（再起動・アプリ更新・時刻変更）を受けて張り直す。
             特にアプリ更新は、OS がそのアプリのアラームを全てキャンセルするため必須。 -->
        <receiver
            android:name=".notification.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- アラームの生存を定期的に確かめる見張り。再発火の鎖が切れていれば繋ぎ直す。
             AlarmManager からのみ呼ばれるため exported=false -->
        <receiver
            android:name=".notification.WatchdogReceiver"
            android:exported="false" />
    </application>

</manifest>
